{
  "name": "b-e-motion",
  "private": true,
  "version": "0.1.0",
  "description": "B-E Motion: an easy browser-based editor for designs (Canva-style) and videos (CapCut-style).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:pages": "tsc -b && vite build && rm -rf app && cp -r dist app",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:e2e": "node e2e/full.mjs",
    "test:e2e:pro": "node e2e/pro.mjs",
    "test:e2e:next": "node e2e/next.mjs",
    "test:e2e:unique": "node e2e/unique.mjs",
    "test:e2e:more": "node e2e/more.mjs",
    "test:e2e:studio": "node e2e/studio.mjs"
  },
  "dependencies": {
    "jsqr": "^1.4.0",
    "mediabunny": "^1.61.3",
    "qrcode-generator": "^2.0.4",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.7.0",
    "playwright": "1.64.1",
    "typescript": "5.6.3",
    "vite": "6.4.4",
    "vitest": "4.1.11"
  }
}
